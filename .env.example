# Copy to .env and fill in. .env is gitignored.
# Keep comments on their own lines: Spring reads this file as .properties.
# Local Postgres, or free cloud Postgres such as Neon (use its direct, non-pooled host):
# DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/baas_db
DB_USERNAME=postgres
DB_PASSWORD=
# 32+ characters of random text
JWT_SECRET=
MAIL_USERNAME=
# Gmail app password
MAIL_PASSWORD=
